#version 150

#moj_import <vesence:sky_common.glsl>

in vec2 TexCoord;
in vec4 FragColor;

out vec4 OutColor;

// ============================================================================
// СИЯНИЕ — полярная ночь.
// Слои:
//   1. холодная полярная ночь;
//   2. звёзды двух масштабов;
//   3. главный зелёный занавес с нитями;
//   4. второй занавес: бирюза -> фиолет, выше и шире;
//   5. третья лента: редкая малиновая вспышка наверху;
//   6. медленная пульсация яркости;
//   7. метеор.
// ============================================================================
void main() {
    vec3 dir = worldRay(gl_FragCoord.xy);
    float h = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);

    // --- 1. Полярная ночь ---
    vec3 col = mix(vec3(0.06, 0.11, 0.22), vec3(0.015, 0.04, 0.12), pow(h, 0.85));

    // --- 2. Звёзды ---
    col += stars(dir, 32.0, 0.17, 0.9);
    col += stars(dir, 68.0, 0.26, 0.35);

    // --- 6. Пульсация ---
    float pulse = 0.85 + 0.15 * sin(Time * 0.3);

    // --- 3. Главный занавес ---
    col += aurora(dir, vec3(0.12, 0.95, 0.48), vec3(0.12, 0.58, 0.85), 1.0, 0.0) * pulse;

    // --- 4. Второй занавес ---
    col += aurora(dir, vec3(0.06, 0.50, 0.68), vec3(0.50, 0.18, 0.92), 0.65, 4.7) * 0.7 * pulse;

    // --- 5. Малиновая лента наверху ---
    float az = atan(dir.x, dir.z);
    float topBand = smoothstep(0.55, 0.75, dir.y) * (0.5 + 0.5 * sin(az * 3.0 + Time * 0.2));
    col += vec3(0.85, 0.20, 0.45) * topBand * fbm3(vec3(az * 4.0, 2.0, Time * 0.05)) * 0.25;

    // --- 7. Метеор ---
    col += shootingStar(dir, 14.0, 8.0, vec3(0.65, 0.88, 0.88));


    // --- 8. Диффузная подложка свечения под занавесами ---
    float az2 = atan(dir.x, dir.z);
    float glowBand = exp(-pow((dir.y - 0.30) / 0.30, 2.0));
    col += vec3(0.08, 0.35, 0.25) * glowBand * (0.5 + 0.5 * sin(az2 * 2.0 + Time * 0.15)) * 0.4;

    // --- 9. Корона-эффект в зените: слабая россыпь лучей ---
    float zen = pow(max(dir.y, 0.0), 6.0);
    col += vec3(0.15, 0.60, 0.45) * zen * fbm3(vec3(az2 * 12.0, 5.0, Time * 0.05)) * 0.35;

    OutColor = vec4(finishSky(softClip(col) * Intensity, dir), 1.0);
}
