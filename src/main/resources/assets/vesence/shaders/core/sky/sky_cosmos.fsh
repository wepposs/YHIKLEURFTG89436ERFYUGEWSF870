#version 150

#moj_import <vesence:sky_common.glsl>

in vec2 TexCoord;
in vec4 FragColor;

out vec4 OutColor;

// ============================================================================
// КОСМОС — глубокий космос.
// Слои:
//   1. глубокий индиго-чёрный градиент;
//   2. два слоя варпленой туманности: фиолет и бирюза;
//   3. золотые очаги в плотных узлах газа;
//   4. Млечный Путь с пылевыми провалами;
//   5. звёзды двух масштабов: крупные с гало и мелкая пыль;
//   6. зодиакальный свет: едва заметный конус у эклиптики;
//   7. редкий медленный метеор.
// ============================================================================
void main() {
    vec3 dir = worldRay(gl_FragCoord.xy);
    float h = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);

    // --- 1. Глубина ---
    vec3 col = mix(vec3(0.10, 0.08, 0.26), vec3(0.02, 0.03, 0.11), pow(h, 0.75));

    // --- 2. Туманности с двойным варпом ---
    vec3 p1 = warp3(dir * 2.0, Time * 0.004, 1.2);
    vec3 p2 = warp3(dir * 3.4 + 17.0, -Time * 0.003, 0.9);
    float n1 = fbm3(p1);
    float n2 = fbm3(p2);
    float veil1 = smoothstep(0.42, 0.72, n1);
    float veil2 = smoothstep(0.46, 0.75, n2);
    col += vec3(0.42, 0.18, 0.85) * veil1 * 0.75;
    col += vec3(0.10, 0.45, 0.90) * veil2 * 0.55;

    // --- 3. Золотые очаги ---
    float cores = smoothstep(0.70, 0.86, n1 * 0.6 + n2 * 0.55);
    col += vec3(0.85, 0.55, 0.25) * cores * 0.5;

    // --- 4. Млечный Путь ---
    col += milkyWay(dir, vec3(0.5, 0.25, 0.4), vec3(0.20, 0.22, 0.42), vec3(0.44, 0.38, 0.52), 0.9);

    // --- 5. Звёзды: крупные с гало + пыль ---
    float nebMask = 1.0 - veil1 * 0.5 - veil2 * 0.3;
    col += stars(dir, 30.0, 0.16, 1.1) * nebMask;
    col += stars(dir, 65.0, 0.30, 0.4) * nebMask;

    // --- 6. Зодиакальный свет ---
    float zod = exp(-pow(angDist(dir, worldDir(300.0, 8.0)) / 0.5, 2.0));
    col += vec3(0.22, 0.18, 0.14) * zod * 0.4;

    // --- 7. Метеор ---
    col += shootingStar(dir, 10.0, 3.0, vec3(0.75, 0.82, 1.0));

    OutColor = vec4(finishSky(softClip(col) * Intensity, dir), 1.0);
}
