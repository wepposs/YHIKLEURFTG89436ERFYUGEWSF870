#version 150

#moj_import <vesence:sky_common.glsl>

in vec2 TexCoord;
in vec4 FragColor;

out vec4 OutColor;

// ============================================================================
// САКУРА — розовая весна и лепестки.
// Слои:
//   1. градиент: розовый зефир -> сирень -> вечерняя синь;
//   2. тёплое мягкое солнце;
//   3. три слоя лепестков: крупные близко, мелкие далеко, все качаются;
//   4. лёгкие облака-пёрышки;
//   5. розовый румянец у горизонта;
//   6. тёплая пыльца в воздухе.
// ============================================================================
void main() {
    vec3 dir = worldRay(gl_FragCoord.xy);
    float h = clamp(dir.y, -0.25, 1.0);

    // --- 1. Градиент ---
    vec3 col = mix(vec3(1.08, 0.80, 0.85), vec3(0.99, 0.65, 0.77), smoothstep(0.00, 0.28, h));
    col = mix(col, vec3(0.66, 0.54, 0.86), smoothstep(0.28, 0.62, h));
    col = mix(col, vec3(0.38, 0.36, 0.72), smoothstep(0.62, 0.97, h));

    vec3 sd = worldDir(35.0, 18.0);

    // --- 2. Солнце ---
    col += softSun(dir, sd, 0.048, vec3(1.75, 1.5, 1.3), vec3(1.05, 0.72, 0.60), 0.6);

    // --- 4. Облака-пёрышки (до лепестков, чтобы лепестки поверх) ---
    float cir = cirrus(dir, vec3(Time * 0.009, 0.0, 0.0), 2.4);
    col = mix(col, vec3(1.05, 0.90, 0.95), cir * 0.30);

    // --- 3. Лепестки: три слоя глубины ---
    col += particles(dir, 8.0, 0.12, vec3(0.05, -0.16, 0.03), vec3(1.06, 0.62, 0.72), 55.0) * 0.55;
    col += particles(dir, 13.0, 0.10, vec3(-0.03, -0.24, 0.05), vec3(1.08, 0.74, 0.82), 85.0) * 0.45;
    col += particles(dir, 20.0, 0.08, vec3(0.02, -0.34, -0.02), vec3(1.02, 0.82, 0.88), 130.0) * 0.35;

    // --- 5. Румянец ---
    col += vec3(1.05, 0.55, 0.60) * exp(-pow((dir.y + 0.01) / 0.16, 2.0)) * 0.22;

    // --- 6. Пыльца ---
    col += particles(dir, 30.0, 0.04, vec3(0.01, -0.05, 0.01), vec3(1.1, 0.9, 0.6), 200.0) * 0.25;


    // --- 7. Крупный передний план лепестков ---
    col += particles(dir, 5.0, 0.10, vec3(0.04, -0.12, 0.03), vec3(1.10, 0.60, 0.70), 40.0) * 0.5;

    // --- 8. Вечерняя роза на западе ---
    col += vec3(0.85, 0.40, 0.55) * exp(-pow(angDist(dir, worldDir(280.0, 10.0)) / 0.5, 2.0)) * 0.25;

    OutColor = vec4(finishSky(softClip(col) * Intensity, dir), 1.0);
}
